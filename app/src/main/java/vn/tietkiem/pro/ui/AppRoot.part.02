                    Row(verticalAlignment = Alignment.CenterVertically) {
                        Column(Modifier.weight(1f)) {
                            Text(goal.name, fontWeight = FontWeight.Bold)
                            Text(goal.deadline?.let { "Hạn ${dateOnly(it)}" } ?: "Không đặt hạn")
                        }
                        IconButton(onClick = { onDelete(goal) }) { Icon(Icons.Default.Delete, "Xóa") }
                    }
                    LinearProgressIndicator(progress = { p.coerceIn(0f, 1f) }, modifier = Modifier.fillMaxWidth())
                    Spacer(Modifier.height(5.dp))
                    Text("${money(goal.savedAmount)} / ${money(goal.targetAmount)} • ${(p * 100).coerceIn(0f, 999f).toInt()}%")
                    val monthly = goal.deadline?.let { requiredPerMonth(goal.targetAmount - goal.savedAmount, it) }
                    if (monthly != null && monthly > 0) Text("Cần khoảng ${money(monthly)}/tháng", color = MaterialTheme.colorScheme.primary)
                }
            }
        }
    }
}

@Composable
private fun DebtList(debts: List<DebtEntity>, onEdit: (DebtEntity) -> Unit, onDelete: (DebtEntity) -> Unit) {
    if (debts.isEmpty()) EmptyState("Chưa có khoản nợ") else LazyColumn(Modifier.fillMaxSize(), contentPadding = PaddingValues(12.dp)) {
        items(debts, key = { it.id }) { debt ->
            val paid = (debt.originalAmount - debt.remainingAmount).coerceAtLeast(0)
            val p = if (debt.originalAmount > 0) paid.toFloat() / debt.originalAmount else 0f
            ElevatedCard(Modifier.fillMaxWidth().padding(vertical = 5.dp).clickable { onEdit(debt) }) {
                Column(Modifier.padding(14.dp)) {
                    Row(verticalAlignment = Alignment.CenterVertically) {
                        Column(Modifier.weight(1f)) {
                            Text(debt.name, fontWeight = FontWeight.Bold)
                            Text(if (debt.type == DebtType.PAYABLE.name) "Mình cần trả" else "Cần thu về")
                        }
                        Text(money(debt.remainingAmount), fontWeight = FontWeight.Bold)
                        IconButton(onClick = { onDelete(debt) }) { Icon(Icons.Default.Delete, "Xóa") }
                    }
                    LinearProgressIndicator(progress = { p.coerceIn(0f, 1f) }, modifier = Modifier.fillMaxWidth())
                    if (debt.annualInterestRate > 0) Text("Lãi suất ${debt.annualInterestRate}%/năm")
                }
            }
        }
    }
}

@Composable
private fun RecurringList(
    recurringItems: List<RecurringEntity>,
    accounts: List<AccountEntity>,
    categories: List<CategoryEntity>,
    onEdit: (RecurringEntity) -> Unit,
    onDelete: (RecurringEntity) -> Unit,
    onPostDue: () -> Unit
) {
    Column(Modifier.fillMaxSize()) {
        Row(Modifier.fillMaxWidth().padding(12.dp), verticalAlignment = Alignment.CenterVertically) {
            Text("Tự động ghi khi đến hạn", Modifier.weight(1f), color = MaterialTheme.colorScheme.onSurfaceVariant)
            TextButton(onClick = onPostDue) { Icon(Icons.Default.Refresh, null); Spacer(Modifier.width(5.dp)); Text("Cập nhật") }
        }
        if (recurringItems.isEmpty()) EmptyState("Chưa có giao dịch định kỳ") else LazyColumn(Modifier.fillMaxSize(), contentPadding = PaddingValues(horizontal = 12.dp)) {
            items(recurringItems, key = { it.id }) { item ->
                ElevatedCard(Modifier.fillMaxWidth().padding(vertical = 5.dp).clickable { onEdit(item) }) {
                    ListItem(
                        headlineContent = { Text(item.name, fontWeight = FontWeight.Bold) },
                        supportingContent = {
                            Text("${recurringLabel(item.interval)} • ${dateOnly(item.nextDueAt)} • ${accounts.firstOrNull { it.id == item.accountId }?.name ?: "Ví"}")
                        },
                        trailingContent = {
                            Row(verticalAlignment = Alignment.CenterVertically) {
                                Text(money(item.amount), fontWeight = FontWeight.Bold)
                                IconButton(onClick = { onDelete(item) }) { Icon(Icons.Default.Delete, "Xóa") }
                            }
                        }
                    )
                }
            }
        }
    }
}

@Composable
private fun AnalyticsScreen(vm: AppViewModel) {
    val dashboard by vm.dashboard.collectAsStateWithLifecycle()
    val categorySpend by vm.categorySpend.collectAsStateWithLifecycle()
    val transactions by vm.transactions.collectAsStateWithLifecycle()
    val maxSpend = categorySpend.maxOfOrNull { it.amount } ?: 1L
    val avgDaily = if (dashboard.expenseThisMonth > 0) dashboard.expenseThisMonth / max(1, Calendar.getInstance().get(Calendar.DAY_OF_MONTH)) else 0L
    val expenseDelta = if (dashboard.previousExpense > 0) ((dashboard.expenseThisMonth - dashboard.previousExpense).toDouble() / dashboard.previousExpense * 100) else null

    LazyColumn(Modifier.fillMaxSize(), contentPadding = PaddingValues(16.dp), verticalArrangement = Arrangement.spacedBy(12.dp)) {
        item {
            Text("Phân tích", style = MaterialTheme.typography.headlineMedium, fontWeight = FontWeight.Bold)
            Text(monthDisplay(System.currentTimeMillis()), color = MaterialTheme.colorScheme.onSurfaceVariant)
        }
        item {
            Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(10.dp)) {
                MetricCard("Chi tháng", money(dashboard.expenseThisMonth), Modifier.weight(1f))
                MetricCard("TB/ngày", money(avgDaily), Modifier.weight(1f))
            }
        }
        item {
            ElevatedCard(Modifier.fillMaxWidth()) {
                Column(Modifier.padding(16.dp)) {
                    Text("So với tháng trước", fontWeight = FontWeight.Bold)
                    Text(
                        expenseDelta?.let { value ->
                            if (value >= 0) "Chi tiêu tăng ${"%.1f".format(value)}%" else "Chi tiêu giảm ${"%.1f".format(abs(value))}%"
                        } ?: "Chưa đủ dữ liệu tháng trước",
                        style = MaterialTheme.typography.titleMedium
                    )
                    Text("Tháng trước ${money(dashboard.previousExpense)}", color = MaterialTheme.colorScheme.onSurfaceVariant)
                }
            }
        }
        item {
            ElevatedCard(Modifier.fillMaxWidth()) {
                Column(Modifier.padding(16.dp)) {
                    Text("Tỷ lệ tiết kiệm", fontWeight = FontWeight.Bold)
                    val p = dashboard.savingRate.toFloat().coerceIn(0f, 1f)
                    Text("${(dashboard.savingRate * 100).toInt()}%", style = MaterialTheme.typography.headlineMedium)
                    LinearProgressIndicator(progress = { p }, modifier = Modifier.fillMaxWidth())
                }
            }
        }
        item { SectionTitle("Chi theo danh mục") }
        if (categorySpend.isEmpty()) item { EmptyState("Chưa có dữ liệu chi tiêu") }
        items(categorySpend, key = { it.category.id }) { spend ->
            Column {
                Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
                    Text(spend.category.name, fontWeight = FontWeight.SemiBold)
                    Text(money(spend.amount))
                }
                LinearProgressIndicator(progress = { spend.amount.toFloat() / maxSpend }, modifier = Modifier.fillMaxWidth())
            }
        }
        item {
            val count = transactions.count { AppViewModel.monthKey(it.occurredAt) == AppViewModel.monthKey(System.currentTimeMillis()) }
            Text("$count giao dịch trong tháng", color = MaterialTheme.colorScheme.onSurfaceVariant)
        }
    }
}

@Composable
private fun MetricCard(title: String, value: String, modifier: Modifier = Modifier) {
    ElevatedCard(modifier) {
        Column(Modifier.padding(14.dp)) {
            Text(title, color = MaterialTheme.colorScheme.onSurfaceVariant)
            Text(value, fontWeight = FontWeight.Bold, style = MaterialTheme.typography.titleMedium)
        }
    }
}

@Composable
private fun SettingsScreen(vm: AppViewModel, settings: AppSettings, onBiometricRequest: () -> Unit) {
    val categories by vm.categories.collectAsStateWithLifecycle()
    var showPin by remember { mutableStateOf(false) }
    var importUri by remember { mutableStateOf<Uri?>(null) }
    var categoryEditor by remember { mutableStateOf<CategoryEntity?>(null) }
    var creatingCategory by remember { mutableStateOf(false) }
    val exportLauncher = rememberLauncherForActivityResult(ActivityResultContracts.CreateDocument("application/json")) { uri -> uri?.let(vm::exportBackup) }
    val importLauncher = rememberLauncherForActivityResult(ActivityResultContracts.OpenDocument()) { uri -> importUri = uri }

    LazyColumn(Modifier.fillMaxSize(), contentPadding = PaddingValues(16.dp), verticalArrangement = Arrangement.spacedBy(8.dp)) {
        item { Text("Cài đặt", style = MaterialTheme.typography.headlineMedium, fontWeight = FontWeight.Bold) }
        item { SectionTitle("Giao diện") }
        item {
            SingleChoiceSegmentedButtonRow(Modifier.fillMaxWidth()) {
                listOf("SYSTEM" to "Hệ thống", "LIGHT" to "Sáng", "DARK" to "Tối").forEachIndexed { index, (value, label) ->
                    SegmentedButton(
                        selected = settings.theme == value,
                        onClick = { vm.setTheme(value) },
                        shape = SegmentedButtonDefaults.itemShape(index, 3)
                    ) { Text(label) }
                }
            }
        }
        item { SectionTitle("Bảo mật") }
        item {
            ListItem(
                headlineContent = { Text(if (settings.hasPin) "Đổi PIN" else "Bật khóa PIN") },
                leadingContent = { Icon(Icons.Default.Lock, null) },
                modifier = Modifier.clickable { showPin = true }
            )
        }
        if (settings.hasPin) {
            item {
                ListItem(
                    headlineContent = { Text("Sinh trắc học") },
                    supportingContent = { Text("Vân tay hoặc khóa màn hình") },
                    leadingContent = { Icon(Icons.Default.Fingerprint, null) },
                    trailingContent = { Switch(checked = settings.biometricEnabled, onCheckedChange = { enabled -> vm.setBiometric(enabled); if (enabled) onBiometricRequest() }) }
                )
            }
            item { TextButton(onClick = vm::clearPin) { Text("Tắt khóa PIN") } }
        }
        item { SectionTitle("Dữ liệu") }
        item {
            ListItem(
                headlineContent = { Text("Xuất bản sao lưu") },
                supportingContent = { Text("Lưu toàn bộ dữ liệu tài chính thành một tệp") },
                leadingContent = { Icon(Icons.Default.Backup, null) },
                modifier = Modifier.clickable { exportLauncher.launch("TietKiemPro-${AppViewModel.monthKey(System.currentTimeMillis())}.json") }
            )
        }
        item {
            ListItem(
                headlineContent = { Text("Khôi phục dữ liệu") },
                supportingContent = { Text("Thay dữ liệu hiện tại bằng bản sao lưu") },
                leadingContent = { Icon(Icons.Default.Restore, null) },
                modifier = Modifier.clickable { importLauncher.launch(arrayOf("application/json", "text/plain", "*/*")) }
            )
        }
        item {
            Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
                SectionTitle("Danh mục", Modifier.weight(1f))
                IconButton(onClick = { creatingCategory = true }) { Icon(Icons.Default.Add, "Thêm danh mục") }
